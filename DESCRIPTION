    anndataR (>= 1.3.2),
    jsonlite,
    methods,
    rhdf5,
    S4Vectors,
    SingleCellExperiment,
    SummarizedExperiment,
    tibble,
    tidytree,
    TreeSummarizedExperiment
Suggests:
    ape,
    Rarr,
    withr,
    testthat (>= 3.0.0)
Remotes:
